# Runtime connection. On Supabase use the pooled string (port 6543) and append
# ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:password@localhost:5432/unfold"
# Direct connection (port 5432), used by `prisma migrate`.
DIRECT_URL="postgresql://user:password@localhost:5432/unfold"
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
# Optional comma-separated extra origins (e.g. preview URLs)
BETTER_AUTH_TRUSTED_ORIGINS=""
# Google sign-in is enabled only when both are set.
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Without RESEND_API_KEY, OTP emails are printed to the server console (dev only).
RESEND_API_KEY=""
EMAIL_FROM="unfold <onboarding@resend.dev>"
# Optional tldraw license key (Whiteboard boards). Without one tldraw shows a
# watermark and is only licensed for development; see https://tldraw.dev/pricing
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=""
